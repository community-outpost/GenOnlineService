@* One anti-cheat review list: the page header (nav-02) over the data grid blueprint (data-02) in a card, with the review
   state as a toolbar filter; unreviewed rows first, each row links to the player and the match *@
@page "/admin/anticheat/{Kind}"
@inject PortalApi Api
@inject ToastService Toasts
@using DataGridRequest = BlazorBlueprint.Primitives.DataGrid.DataGridRequest

<PageTitle>@(m_list?.Title ?? "Anti-cheat") · Generals Online</PageTitle>

@if (!Api.Session!.Can(PortalPermissions.AnticheatReview))
{
    <Refusal Title="Administrators only" Description="Your account does not hold the anticheat.review permission." Icon="shield-x" />
}
else if (m_list == null)
{
    <Refusal Title="No such list" Description="This anti-cheat review list does not exist." Icon="search-x" />
}
else
{
    <PageHeader Description="@m_list.Description">
        <Title>
            <span class="bb:flex bb:items-center bb:gap-4">
                <LucideIcon Name="@PortalReviewList.IconOf(m_list.Kind)" Class="bb:h-6 bb:w-6 bb:text-muted-foreground" />
                @m_list.Title
            </span>
        </Title>
        <Actions>
            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="RefreshAsync">
                <LucideIcon Name="refresh-cw" Class="bb:h-4 bb:w-4" />
                Refresh
            </BbButton>
        </Actions>
    </PageHeader>

    @if (m_error != null)
    {
        <BbAlert Variant="AlertVariant.Danger">
            <Icon>
                <LucideIcon Name="circle-alert" Class="bb:h-4 bb:w-4" />
            </Icon>
            <ChildContent>
                <BbAlertTitle>The list could not load</BbAlertTitle>
                <BbAlertDescription>@PortalText.Error(m_error)</BbAlertDescription>
            </ChildContent>
        </BbAlert>
    }

    <BbCard Class="go-filtered">
        <BbCardContent Class="bb:pt-6">
            <BbDataGrid @ref="m_grid" @key="Kind" TData="PortalAntiCheatReport" ItemsProvider="@LoadAsync" ItemKey="@(r => r.Id)" InitialPageSize="20" AriaLabel="@m_list.Title">
                <Toolbar>
                    <BbNativeSelect TValue="string" Value="@m_reviewed" ValueChanged="@OnReviewedChanged" AriaLabel="Review state" Class="bb:w-40">
                        <option value="false">Unreviewed</option>
                        <option value="true">Reviewed</option>
                        <option value="all">All</option>
                    </BbNativeSelect>
                </Toolbar>
                <Columns>
                    <BbDataGridPropertyColumn TData="PortalAntiCheatReport" TProp="long" Property="@(r => r.Id)" Title="#" Width="90px" />
                    <BbDataGridPropertyColumn TData="PortalAntiCheatReport" TProp="string" Property="@(r => r.Player.FullName)" Title="Player">
                        <CellTemplate>
                            <BbLink Href="@PortalRoutes.PlayerPage(context.Player.Id)">@(context.Player.Name.Length > 0 ? context.Player.FullName : "#" + context.Player.Id)</BbLink>
                        </CellTemplate>
                    </BbDataGridPropertyColumn>
                    <BbDataGridTemplateColumn TData="PortalAntiCheatReport" Title="Match" Width="110px">
                        <ChildContent Context="report">
                            @if (report.MatchId is long matchID)
                            {
                                <BbLink Href="@PortalRoutes.MatchPage(matchID)">@matchID</BbLink>
                            }
                            else
                            {
                                <BbBadge Variant="BadgeVariant.Outline">sign-in</BbBadge>
                            }
                        </ChildContent>
                    </BbDataGridTemplateColumn>
                    @if (Kind == "modules")
                    {
                        <BbDataGridPropertyColumn TData="PortalAntiCheatReport" TProp="string" Property="@(r => r.ModuleName!)" Title="Module">
                            <CellTemplate>
                                <span class="bb:font-mono">@context.ModuleName</span>
                            </CellTemplate>
                        </BbDataGridPropertyColumn>
                        <BbDataGridPropertyColumn TData="PortalAntiCheatReport" TProp="string" Property="@(r => r.ModulePath!)" Title="Path">
                            <CellTemplate>
                                <span class="bb:font-mono bb:text-xs bb:break-all">@context.ModulePath</span>
                            </CellTemplate>
                        </BbDataGridPropertyColumn>
                        <BbDataGridPropertyColumn TData="PortalAntiCheatReport" TProp="long?" Property="@(r => r.ModuleSize)" Title="Size" Width="110px" />
                    }
                    @if (Kind == "probes" || Kind == "devices")
                    {
                        <BbDataGridPropertyColumn TData="PortalAntiCheatReport" TProp="string" Property="@(r => r.Reason!)" Title="Reason" />
                    }
                    <BbDataGridTemplateColumn TData="PortalAntiCheatReport" Title="Review" Width="180px" Hideable="false">
                        <ChildContent Context="report">
                            @if (report.ReviewedAt is DateTime reviewed)
                            {
                                <BbBadge Variant="BadgeVariant.Secondary"><BbBadgeIcon Name="check" />reviewed @PortalText.Date(reviewed)</BbBadge>
                            }
                            else
                            {
                                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => ReviewAsync(report))" data-testid="mark-reviewed">
                                    <LucideIcon Name="check" Class="bb:h-4 bb:w-4" />
                                    Mark reviewed
                                </BbButton>
                            }
                        </ChildContent>
                    </BbDataGridTemplateColumn>
                </Columns>
                <EmptyTemplate>
                    <BbEmpty Size="EmptySize.Small" Title="@(m_reviewed == "false" ? "Nothing to review" : "No rows")"
                             Description="@(m_reviewed == "false" ? "Every row of this list has been reviewed." : "This list has no rows in this state.")">
                        <Icon>
                            <LucideIcon Name="shield-check" />
                        </Icon>
                    </BbEmpty>
                </EmptyTemplate>
                <LoadingTemplate>
                    <p class="bb:p-4 bb:text-sm bb:text-muted-foreground" role="status">Loading…</p>
                </LoadingTemplate>
            </BbDataGrid>
        </BbCardContent>
    </BbCard>
}

@code {
    [Parameter]
    public string Kind { get; set; } = "";

    [CascadingParameter]
    public PortalLayout? Shell { get; set; }

    private BbDataGrid<PortalAntiCheatReport>? m_grid;
    private PortalReviewList? m_list;
    private string m_reviewed = "false";
    private string? m_error;

    protected override void OnParametersSet()
    {
        m_list = PortalReviewList.Find(Kind);
        m_error = null;
    }

    private async ValueTask<BlazorBlueprint.Primitives.DataGrid.DataGridResult<PortalAntiCheatReport>> LoadAsync(DataGridRequest request)
    {
        PortalAnswer<PortalAntiCheatPage> answer = await Api.GetAntiCheatAsync(Kind, m_reviewed, request.StartIndex, request.Count ?? 20, request.CancellationToken);
        string? error = answer.Ok ? null : answer.Error;
        if (error != m_error)
        {
            m_error = error;
            StateHasChanged();
        }

        PortalAntiCheatPage page = answer.Value ?? new PortalAntiCheatPage();
        return new BlazorBlueprint.Primitives.DataGrid.DataGridResult<PortalAntiCheatReport> { Items = page.Reports.ToList(), TotalItemCount = page.Total };
    }

    private async Task OnReviewedChanged(string? value)
    {
        m_reviewed = value ?? "false";
        if (m_grid != null)
        {
            await m_grid.RefreshDataAsync();
        }
    }

    private async Task ReviewAsync(PortalAntiCheatReport report)
    {
        PortalOutcome outcome = await Api.ReviewAsync(Kind, report.Id);
        if (outcome.Ok)
        {
            Toasts.Success($"Report #{report.Id} is reviewed.", "Marked reviewed");
        }
        else
        {
            Toasts.Error(PortalText.Error(outcome.Error), "Not marked");
        }
        await RefreshAsync();
    }

    // The grid and the sidebar's unreviewed counts
    private async Task RefreshAsync()
    {
        if (m_grid != null)
        {
            await m_grid.RefreshDataAsync();
        }
        if (Shell != null)
        {
            await Shell.RefreshCountsAsync();
        }
    }
}
