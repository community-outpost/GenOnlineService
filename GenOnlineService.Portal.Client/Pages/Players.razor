@* The staff player search: the page header (nav-02) over the data grid blueprint (data-02) in a card. The host matches
   the name part or the id and pages in the database; ?q= (the sidebar search) fills the search box *@
@page "/admin/players"
@inject PortalApi Api
@using DataGridRequest = BlazorBlueprint.Primitives.DataGrid.DataGridRequest

<PageTitle>Players · Generals Online</PageTitle>

<PageHeader Description="Find an account by a part of its display name, any case, of at least 2 characters, or by its player id.">
    <Title>Players</Title>
</PageHeader>

@if (m_error != null)
{
    <BbAlert Variant="AlertVariant.Danger">
        <Icon>
            <LucideIcon Name="circle-alert" Class="bb:h-4 bb:w-4" />
        </Icon>
        <ChildContent>
            <BbAlertTitle>Search failed</BbAlertTitle>
            <BbAlertDescription>@PortalText.Error(m_error)</BbAlertDescription>
        </ChildContent>
    </BbAlert>
}

<BbCard Class="go-filtered">
    <BbCardContent Class="bb:pt-6">
        <BbDataGrid TData="PortalPlayerRow" ItemsProvider="@LoadAsync" ItemKey="@(p => p.Id)" @bind-SearchText="Q"
                    InitialPageSize="20" ShowSearch="true" SearchPlaceholder="Name or player id…" AriaLabel="Players">
            <Columns>
                <BbDataGridPropertyColumn TData="PortalPlayerRow" TProp="long" Property="@(p => p.Id)" Title="Id" Width="100px" />
                <BbDataGridPropertyColumn TData="PortalPlayerRow" TProp="string" Property="@(p => p.FullName)" Title="Player">
                    <CellTemplate>
                        <div class="bb:flex bb:items-center bb:gap-2">
                            <BbAvatar Size="AvatarSize.Small" Class="bb:h-7 bb:w-7">
                                <BbAvatarFallback>@PortalText.Initials(context.Name)</BbAvatarFallback>
                            </BbAvatar>
                            <BbLink Href="@PortalRoutes.PlayerPage(context.Id)" data-testid="player-link">@context.FullName</BbLink>
                        </div>
                    </CellTemplate>
                </BbDataGridPropertyColumn>
                <BbDataGridPropertyColumn TData="PortalPlayerRow" TProp="string" Property="@(p => p.State)" Title="State">
                    <CellTemplate>
                        <BbBadge Variant="@PortalBadges.OfPlayerState(context.State)">@context.State</BbBadge>
                    </CellTemplate>
                </BbDataGridPropertyColumn>
                <BbDataGridPropertyColumn TData="PortalPlayerRow" TProp="string" Property="@(p => PortalText.Date(p.CreatedAt))" Title="Created" />
                <BbDataGridPropertyColumn TData="PortalPlayerRow" TProp="string" Property="@(p => PortalText.Date(p.LastSignInAt))" Title="Last sign-in" />
            </Columns>
            <EmptyTemplate>
                <BbEmpty Size="EmptySize.Small" Title="@(ShortTerm ? "Type a name or an id" : "No player found")"
                         Description="@(ShortTerm ? "The search starts at 2 characters of a display name, or a whole player id." : "No display name contains this, and no account has this id.")">
                    <Icon>
                        <LucideIcon Name="@(ShortTerm ? "search" : "user-x")" />
                    </Icon>
                </BbEmpty>
            </EmptyTemplate>
            <LoadingTemplate>
                <p class="bb:p-4 bb:text-sm bb:text-muted-foreground" role="status">Loading…</p>
            </LoadingTemplate>
        </BbDataGrid>
    </BbCardContent>
</BbCard>

@code {
    // The search box and the address share it, so the sidebar search and a reload keep the term
    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    private string? m_error;

    private bool ShortTerm => !IsSearchable(Q?.Trim() ?? "");

    private static bool IsSearchable(string search) => search.Length >= 2 || (long.TryParse(search, out long id) && id > 0);

    // An empty or too short term lists nothing, the host refuses it
    private async ValueTask<BlazorBlueprint.Primitives.DataGrid.DataGridResult<PortalPlayerRow>> LoadAsync(DataGridRequest request)
    {
        string search = request.SearchText?.Trim() ?? "";
        PortalPlayerPage page = new PortalPlayerPage();
        string? error = null;
        if (IsSearchable(search))
        {
            PortalAnswer<PortalPlayerPage> answer = await Api.SearchPlayersAsync(search, request.StartIndex, request.Count ?? 20, request.CancellationToken);
            page = answer.Value ?? page;
            error = answer.Ok ? null : answer.Error;
        }

        if (error != m_error)
        {
            m_error = error;
            StateHasChanged();
        }
        return new BlazorBlueprint.Primitives.DataGrid.DataGridResult<PortalPlayerRow> { Items = page.Players.ToList(), TotalItemCount = page.Total };
    }
}
