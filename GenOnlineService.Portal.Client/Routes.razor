@* The router of the WebAssembly pages, the host renders it without a server circuit *@
<Router AppAssembly="typeof(Routes).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(PortalLayout)" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(PortalLayout)">
            <BbEmpty Title="Page not found" Description="This page does not exist in the portal." />
        </LayoutView>
    </NotFound>
</Router>
