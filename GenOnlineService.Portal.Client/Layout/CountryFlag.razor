@* The flag of a two-letter country code, beside the code itself: an SVG the service serves (wwwroot/portal/flags),
   nothing loaded from another site. Decorative, since the code next to it already reads; an unknown or null code shows
   nothing *@
@if (PortalText.CountryFlag(Country) is string flag)
{
    <img class="go-flag" src="@flag" alt="" title="@Country!.ToUpperInvariant()" width="20" height="15" loading="lazy" decoding="async" data-testid="country-flag" />
}

@code {
    [Parameter]
    public string? Country { get; set; }
}
