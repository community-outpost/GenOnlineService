@* The page header of the "Breadcrumb + Page Header" blueprint (nav-02): title and description on the left, the page's
   actions on the right; the breadcrumb itself is in the shell's top bar *@

<div class="go-page-header">
    <div class="bb:space-y-1 bb:min-w-0">
        <h1 class="go-page-title" data-testid="page-title">@Title</h1>
        @if (Description != null)
        {
            <p class="bb:text-sm bb:text-muted-foreground">@Description</p>
        }
        @Below
    </div>
    @if (Actions != null)
    {
        <div class="bb:flex bb:items-center bb:gap-2 bb:flex-wrap">
            @Actions
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public RenderFragment? Title { get; set; }

    [Parameter]
    public string? Description { get; set; }

    // badges or a line of facts under the description
    [Parameter]
    public RenderFragment? Below { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }
}
