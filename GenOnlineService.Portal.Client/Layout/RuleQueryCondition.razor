@using System.Text.Json

@* One condition of the query builder on one row: a field of the catalogue the trigger provides, an operator of the
   field's type and a value of that type, then the remove button. A yes or no field is one choice that names its state,
   such as Email is not confirmed, in place of an operator and a value. The problems the host found show under the row. *@

@{
    PortalRuleField? field = Catalog?.Find(Condition.Field);
    string type = field?.Type ?? "text";
    string op = Condition.Operator ?? "";
    string? state = StateOf(field);
    string shape = state != null ? "go-rule-condition-row-choice" : op == PortalRuleWords.InList ? "go-rule-condition-row-list" : op == PortalRuleWords.IsEmpty ? "go-rule-condition-row-bare" : "";
}
<div class="go-rule-condition" data-testid="rule-condition">
    <div class="go-rule-condition-row @shape">
        <BbNativeSelect TValue="string" Id="@($"{m_id}-field")" Value="@(state ?? Condition.Field ?? "")" ValueChanged="@((string v) => SetFieldAsync(v))" AriaLabel="@(state != null ? "Condition" : "Field")" Class="go-rule-field">
            @if (field == null)
            {
                <option value="@(Condition.Field ?? "")">@(String.IsNullOrEmpty(Condition.Field) ? "Choose a field" : Condition.Field + " (unknown)")</option>
            }
            else if (field.Type == "bool" && state == null)
            {
                @* a yes or no field with another operator, as rules saved by hand may hold, keeps its plain choice *@
                <option value="@field.Key">@field.Label</option>
            }
            @foreach (IGrouping<string, PortalRuleField> section in Fields().GroupBy(f => SectionOf(f.Key)))
            {
                <optgroup label="@section.Key">
                    @foreach (PortalRuleField choice in section)
                    {
                        @if (choice.Type == "bool" && choice.TrueLabel != null && choice.FalseLabel != null)
                        {
                            <option value="@(choice.Key + StateTrue)">@choice.TrueLabel</option>
                            <option value="@(choice.Key + StateFalse)">@choice.FalseLabel</option>
                        }
                        else
                        {
                            <option value="@choice.Key">@choice.Label</option>
                        }
                    }
                </optgroup>
            }
        </BbNativeSelect>
        @if (state == null)
        {
            <BbNativeSelect TValue="string" Id="@($"{m_id}-operator")" Value="@op" ValueChanged="@((string v) => SetOperatorAsync(v, type))" AriaLabel="Operator" Class="go-rule-operator">
                @foreach (string choice in field?.Operators ?? [op])
                {
                    <option value="@choice" aria-label="@PortalRuleWords.OperatorLabel(choice)" title="@PortalRuleWords.OperatorLabel(choice)">@PortalRuleWords.OperatorSymbol(choice)</option>
                }
            </BbNativeSelect>
            @if (op == PortalRuleWords.Between)
            {
                <span class="go-rule-range">
                    <BbInput Type="InputType.Number" Value="@m_low" ValueChanged="@((string? v) => SetRangeAsync(v ?? "", m_high))" UpdateTiming="UpdateTiming.OnChange" AriaLabel="From" AriaInvalid="@Invalid" Class="go-rule-value" />
                    <span class="go-muted bb:text-sm">and</span>
                    <BbInput Type="InputType.Number" Value="@m_high" ValueChanged="@((string? v) => SetRangeAsync(m_low, v ?? ""))" UpdateTiming="UpdateTiming.OnChange" AriaLabel="To" AriaInvalid="@Invalid" Class="go-rule-value" />
                </span>
            }
            else if (op == PortalRuleWords.InList)
            {
                <BbTextarea Value="@m_text" ValueChanged="@((string? v) => SetTextAsync(v ?? "", type))" UpdateTiming="UpdateTiming.OnChange" Placeholder="One value a line" AriaLabel="Values, one a line" AriaInvalid="@Invalid" Class="go-rule-list" spellcheck="false" />
            }
            else if (type == "bool" && op != PortalRuleWords.IsEmpty)
            {
                <BbNativeSelect TValue="string" Value="@m_text" ValueChanged="@((string v) => SetTextAsync(v, type))" AriaLabel="Value" Class="go-rule-value">
                    <option value="true">true</option>
                    <option value="false">false</option>
                </BbNativeSelect>
            }
            else if (op != PortalRuleWords.IsEmpty)
            {
                <BbInput Type="@(type == "number" ? InputType.Number : InputType.Text)" Value="@m_text" ValueChanged="@((string? v) => SetTextAsync(v ?? "", type))" UpdateTiming="UpdateTiming.OnChange"
                         Placeholder="@Hint(type)" AriaLabel="Value" AriaInvalid="@Invalid" Class="go-rule-value" autocomplete="off" spellcheck="false" />
            }
        }
        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="@(() => OnRemove.InvokeAsync())" AriaLabel="Remove this condition" Class="go-rule-remove">
            <LucideIcon Name="x" Class="bb:h-4 bb:w-4" />
        </BbButton>
    </div>
    @if (m_problem != null)
    {
        <p class="go-rule-problem" role="alert">@m_problem</p>
    }
    @foreach (RuleNodeProblem problem in RuleProblems.At(Problems, NodeId, Path))
    {
        <p class="go-rule-problem" role="alert">@RuleProblems.Where(problem.Path): @problem.Reason</p>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public PortalRuleQuery Condition { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Path { get; set; } = "";

    [Parameter, EditorRequired]
    public string NodeId { get; set; } = "";

    [Parameter]
    public string? Trigger { get; set; }

    [Parameter]
    public PortalRuleCatalog? Catalog { get; set; }

    [Parameter]
    public IReadOnlyList<RuleNodeProblem> Problems { get; set; } = [];

    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }

    // the choice of a yes or no field names its state after the key
    private const string StateTrue = "=true";
    private const string StateFalse = "=false";

    private string m_id = "";
    private string m_text = "";
    private string m_low = "";
    private string m_high = "";
    private string? m_problem;

    // the value the texts were last taken from, so a change made elsewhere shows and a typed text stays
    private string? m_shown;

    private bool? Invalid => m_problem != null || RuleProblems.At(Problems, NodeId, Path).Any() ? true : null;

    protected override void OnParametersSet()
    {
        m_id = "rule-" + System.Text.RegularExpressions.Regex.Replace(NodeId + "-" + Path, "[^A-Za-z0-9-]", "-");
        string raw = Condition.Value?.GetRawText() ?? "";
        if (raw != m_shown)
        {
            m_shown = raw;
            m_text = RuleValues.Text(Condition.Value);
            (m_low, m_high) = RuleValues.Range(Condition.Value);
            m_problem = null;
        }
    }

    // The fields the rule's trigger provides, and the one the condition holds even when it does not
    private IEnumerable<PortalRuleField> Fields() =>
        (Catalog?.Fields ?? []).Where(f => Trigger == null || f.Triggers.Contains(Trigger) || f.Key == Condition.Field);

    // The section of a field by its Elastic Common Schema key
    private static string SectionOf(string key) => key switch
    {
        _ when key.StartsWith("host.", StringComparison.Ordinal) => "Devices",
        _ when key.StartsWith("source.", StringComparison.Ordinal) => "Network",
        _ when key.StartsWith("user.sanctions.", StringComparison.Ordinal) || key.StartsWith("user.reports.", StringComparison.Ordinal) => "Sanctions and reports",
        _ when key.StartsWith("user.anticheat.", StringComparison.Ordinal) => "Anti-cheat",
        _ when key.StartsWith("user.stats.", StringComparison.Ordinal) => "Match stats",
        _ when key.StartsWith("user.", StringComparison.Ordinal) => "Account",
        _ when key.StartsWith("event.", StringComparison.Ordinal) || key.StartsWith("game.", StringComparison.Ordinal) => "The event",
        _ => "Other"
    };

    private static string Hint(string type) => type switch
    {
        "device" => "The raw id or the device key",
        "ip" => "An address, a prefix or a range",
        "number" => "A number",
        _ => "A value"
    };

    // The choice the row shows for a yes or no field that is equal to true or false, null for any other condition
    private string? StateOf(PortalRuleField? field)
    {
        if (field is not { Type: "bool", TrueLabel: not null, FalseLabel: not null } || Condition.Operator != "equals" || Condition.Value is not JsonElement value)
        {
            return null;
        }
        return value.ValueKind switch
        {
            JsonValueKind.True => field.Key + StateTrue,
            JsonValueKind.False => field.Key + StateFalse,
            _ => null
        };
    }

    // A new field keeps the operator when the field has it, otherwise takes its first, and starts without a value. The
    // choice of a yes or no field sets the field, equals and the state at once.
    private Task SetFieldAsync(string key)
    {
        foreach ((string suffix, bool wanted) in new[] { (StateTrue, true), (StateFalse, false) })
        {
            if (key.EndsWith(suffix, StringComparison.Ordinal))
            {
                Condition.Field = key.Substring(0, key.Length - suffix.Length);
                Condition.Operator = "equals";
                Condition.Value = JsonSerializer.SerializeToElement(wanted);
                return OnChanged.InvokeAsync();
            }
        }
        PortalRuleField? field = Catalog?.Find(key);
        Condition.Field = key;
        if (field != null && !field.Operators.Contains(Condition.Operator ?? ""))
        {
            Condition.Operator = field.Operators.FirstOrDefault();
        }
        Condition.Value = field == null ? null : RuleValues.Default(field.Type, Condition.Operator ?? "");
        return OnChanged.InvokeAsync();
    }

    // The typed value is kept when it still fits the new operator
    private Task SetOperatorAsync(string op, string type)
    {
        Condition.Operator = op;
        Condition.Value = op == PortalRuleWords.Between ? RuleValues.ParseRange(m_low, m_high, out _) : RuleValues.Parse(type, op, m_text, out _) ?? RuleValues.Default(type, op);
        return OnChanged.InvokeAsync();
    }

    private Task SetTextAsync(string text, string type)
    {
        m_text = text;
        Condition.Value = RuleValues.Parse(type, Condition.Operator ?? "", text, out m_problem);
        m_shown = Condition.Value?.GetRawText() ?? "";
        return OnChanged.InvokeAsync();
    }

    private Task SetRangeAsync(string low, string high)
    {
        m_low = low;
        m_high = high;
        Condition.Value = RuleValues.ParseRange(low, high, out m_problem);
        m_shown = Condition.Value?.GetRawText() ?? "";
        return OnChanged.InvokeAsync();
    }
}
