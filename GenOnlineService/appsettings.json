        "allow_sign_up": true,
        "only_provider": true,
        "auto_link_verified_email": false,
        "trusted": true,
        "link_claim": "go_user_id",
        "groups_claim": "groups",
        "role_groups": { "genonline-admin": "admin", "genonline-moderator": "moderator" },
        "ban_group": "genonline-banned",
        "group_sync": {
          "enabled": false,
          "interval_seconds": 15,
          "realm": null,
          "admin_base_url": null,
          "client_id": null,
          "client_secret": null
