    "refresh_reuse_leeway_seconds": 30,
    "signing_certificate_paths": [],
    "encryption_certificate_paths": [],
    "certificate_password": null,
    "ephemeral_keys": false,
    "clients": [
      { "client_id": "generalsmd", "display_name": "Generals Online (Zero Hour)", "redirect_uris": [ "http://127.0.0.1/callback", "http://[::1]/callback" ] },
      { "client_id": "generals", "display_name": "Generals Online (Generals)", "redirect_uris": [ "http://127.0.0.1/callback", "http://[::1]/callback" ] },
      { "client_id": "launcher", "display_name": "Generals Online Launcher", "redirect_uris": [ "http://127.0.0.1/callback", "http://[::1]/callback" ] },
      { "client_id": "chat", "display_name": "Generals Online Chat", "redirect_uris": [ "http://127.0.0.1/callback", "http://[::1]/callback" ] },
      { "client_id": "genhub", "display_name": "GenHub", "redirect_uris": [ "http://127.0.0.1/callback", "http://[::1]/callback" ] }
    ],
    "providers": {
      "keycloak": {
        "enabled": false,
        "display_name": "Generals Online Account",
        "issuer": "https://auth.example.org/realms/genonline",
