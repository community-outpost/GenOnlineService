@using GenOnlineService.Identity
@* The HTML document of the staff pages: dark only, the same three stylesheets in the same order as the sign-in pages (PortalLook) *@
<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0c0a09" />
    <base href="/" />
    <title>Admin · Generals Online</title>
    <link rel="stylesheet" href="@PortalLook.ThemePath" />
    <link rel="stylesheet" href="@PortalLook.StylesheetPath" />
    <link rel="stylesheet" href="@PortalLook.GeneralsPath" />
    @if (PortalSetup.HostDataOf(HttpContext) is PortalHostData host)
    {
        @* who is signed in, and the antiforgery token the pages send with every /api/v1 change (GitLab's csrf-token) *@
        <meta name="go-portal-session" content="@host.Session" />
        <meta name="csrf-header" content="@host.CsrfHeader" />
        <meta name="csrf-token" content="@host.CsrfToken" />
    }
    <script>window.goPortalMeta = function (name) { var meta = document.querySelector('meta[name="' + name + '"]'); return meta ? meta.getAttribute('content') : null; };</script>
    @Head
</head>
<body class="bb:bg-background bb:text-foreground">
    @ChildContent
</body>
</html>

@code {
    // set while the page renders on the server, which is the only time this document renders
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    [Parameter]
    public RenderFragment? Head { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
